<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="RunWise.Pages.ExercisesPage"
             ControlTemplate="{StaticResource BottomNavPageTemplate}"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="Exercises">

    <ContentPage.Content>
        <StackLayout Padding="24" Spacing="20" HorizontalOptions="Center" VerticalOptions="Center">
            <Label Text="Exercises" FontSize="24" HorizontalOptions="Center" />
            <Button Text="Pre Workout" Clicked="OnStartPreRunClicked" WidthRequest="220" HeightRequest="56" />
            <Button Text="Post Workout" Clicked="OnStartPostRunClicked" WidthRequest="220" HeightRequest="56" />
        </StackLayout>
    </ContentPage.Content>

</ContentPage>
