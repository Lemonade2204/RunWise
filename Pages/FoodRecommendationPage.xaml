<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="RunWise.Pages.FoodRecommendationPage"
             ControlTemplate="{StaticResource BottomNavPageTemplate}"
             Title="Food Recommendation">

    <VerticalStackLayout Padding="20" Spacing="12">
        
        <HorizontalStackLayout Spacing="8" VerticalOptions="Start">
            <Label x:Name="TargetMealLabel" Text="Food" FontAttributes="Bold" VerticalOptions="Center" />
            <Picker x:Name="MealTypePicker" Title="Meal" WidthRequest="150" />
            <Label x:Name="TotalCaloriesLabel" Text="0 kcal" HorizontalOptions="EndAndExpand" VerticalOptions="Center" />
        </HorizontalStackLayout>

        <Label Text="Enter food to search:" />
        <Entry x:Name="CaloriesEntry" Placeholder="e.g. pancit canton" />

        <Button Text="Get Recommendation" Clicked="OnGetRecommendationClicked" />
       
        <Frame CornerRadius="6" Padding="10" BackgroundColor="#F2F2F2">
            <VerticalStackLayout>
                <Label x:Name="PickLabel" FontAttributes="Bold" />
            </VerticalStackLayout>
        </Frame>

        <Label Text="Suggestion:" FontAttributes="Bold" />

        <!-- Make the collection fill remaining space so it can scroll. -->
        <CollectionView x:Name="CandidatesList" VerticalOptions="FillAndExpand" HeightRequest="300">
            <CollectionView.ItemsLayout>
                <LinearItemsLayout Orientation="Vertical" ItemSpacing="8" />
            </CollectionView.ItemsLayout>
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <!-- Card-like frame for each suggestion -->
                    <Frame CornerRadius="8" Padding="10" Margin="0,4" BackgroundColor="#FFFFFF" BorderColor="#E0E0E0" HasShadow="False">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <VerticalStackLayout Grid.Column="0" Spacing="2">
                                <Label Text="{Binding Title}" FontAttributes="Bold" LineBreakMode="TailTruncation" />
                                <Label Text="{Binding Guidance}" FontAttributes="Italic" FontSize="Small" LineBreakMode="TailTruncation" />
                                <Label Text="{Binding Description}" FontSize="Small" TextColor="#666" LineBreakMode="TailTruncation" />
                            </VerticalStackLayout>

                            <VerticalStackLayout Grid.Column="1" HorizontalOptions="End" VerticalOptions="Center" Spacing="2">
                                <Label Text="{Binding CaloriesDisplay}" HorizontalTextAlignment="End" />
                                <Button Text="Add" Clicked="OnAddToMealClicked" FontSize="Small" />
                            </VerticalStackLayout>
                        </Grid>
                    </Frame>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </VerticalStackLayout>

</ContentPage>
