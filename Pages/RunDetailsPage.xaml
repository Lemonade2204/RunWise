<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="RunWise.Pages.RunDetailsPage"
             Title="Run Details">

    <ScrollView>
        <VerticalStackLayout Spacing="16">
            <!-- Top distance banner -->
            <Grid BackgroundColor="{StaticResource Primary}" Padding="28" HorizontalOptions="Fill">
                <VerticalStackLayout HorizontalOptions="Center" VerticalOptions="Center" Spacing="6">
                    <Label Text="DISTANCE" TextColor="White" FontSize="12" HorizontalOptions="Center"/>
                    <Label Text="{Binding DistanceFormatted}" TextColor="White" FontAttributes="Bold" FontSize="72" HorizontalOptions="Center" />
                    <Label Text="kilometers" TextColor="White" FontSize="14" HorizontalOptions="Center"/>
                </VerticalStackLayout>
            </Grid>

            <!-- Metrics grid -->
            <Grid Padding="20" RowSpacing="12" ColumnSpacing="12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Duration -->
                <Frame Grid.Row="0" Grid.Column="0" CornerRadius="12" HasShadow="False" BackgroundColor="{StaticResource White}" Padding="12">
                    <VerticalStackLayout>
                        <Label Text="DURATION" FontSize="12" TextColor="{StaticResource SecondaryDarkText}" />
                        <Label Text="{Binding DurationFormatted}" FontAttributes="Bold" FontSize="20" TextColor="{StaticResource Gray950}" />
                    </VerticalStackLayout>
                </Frame>

                <!-- Avg Pace -->
                <Frame Grid.Row="0" Grid.Column="1" CornerRadius="12" HasShadow="False" BackgroundColor="{StaticResource White}" Padding="12">
                    <VerticalStackLayout>
                        <Label Text="AVG PACE" FontSize="12" TextColor="#6C33FF" />
                        <Label Text="{Binding AveragePaceFormatted}" FontAttributes="Bold" FontSize="20" TextColor="{StaticResource Gray950}" />
                    </VerticalStackLayout>
                </Frame>

                <!-- Calories -->
                <Frame Grid.Row="1" Grid.Column="0" CornerRadius="12" HasShadow="False" BackgroundColor="{StaticResource White}" Padding="12">
                    <VerticalStackLayout>
                        <Label Text="CALORIES" FontSize="12" TextColor="#FF6A00" />
                        <Label Text="{Binding CaloriesDisplay}" FontAttributes="Bold" FontSize="20" TextColor="{StaticResource Gray950}" />
                    </VerticalStackLayout>
                </Frame>

                <!-- Steps -->
                <Frame Grid.Row="1" Grid.Column="1" CornerRadius="12" HasShadow="False" BackgroundColor="{StaticResource White}" Padding="12">
                    <VerticalStackLayout>
                        <Label Text="STEPS" FontSize="12" TextColor="#1DB954" />
                        <Label Text="{Binding StepsDisplay}" FontAttributes="Bold" FontSize="20" TextColor="{StaticResource Gray950}" />
                    </VerticalStackLayout>
                </Frame>
            </Grid>

            <!-- Actions -->
            <HorizontalStackLayout Padding="20" Spacing="12" HorizontalOptions="Center">
                <Button Text="Export PDF" Clicked="OnExportPdfClicked" />
                <Button Text="Recommend Food" Clicked="OnRecommendFoodClicked" />
                <Button Text="Close" Clicked="OnCloseClicked" />
            </HorizontalStackLayout>
        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
