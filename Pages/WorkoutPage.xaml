<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="RunWise.Pages.WorkoutPage"
             Title="Workout">

    <StackLayout Padding="12" Spacing="10">
        <Label x:Name="TitleLabel" Text="Workout" FontSize="20" FontAttributes="Bold" HorizontalOptions="Center" />

        <Button Text="Start Workout" x:Name="StartButton" Clicked="OnStartClicked" />

        <CollectionView x:Name="ExercisesCollection" SelectionMode="Single">
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Frame Margin="0,4" Padding="8" CornerRadius="8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackLayout>
                                <Label Text="{Binding Title}" FontAttributes="Bold" />
                                <Label Text="{Binding Description}" FontSize="13" TextColor="Gray" />
                            </StackLayout>
                            <Button Text="View" Grid.Column="1" Clicked="OnViewClicked" CommandParameter="{Binding .}" />
                        </Grid>
                    </Frame>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

    </StackLayout>

</ContentPage>
