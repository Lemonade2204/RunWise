<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="RunWise.Pages.EditRunPage"
             Title="Edit Run">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="16">
            <Label Text="Start Date and Time" FontAttributes="Bold" />
            <HorizontalStackLayout Spacing="8">
                <DatePicker Date="{Binding StartDate, Mode=TwoWay}" />
                <TimePicker Time="{Binding StartTimeOfDay, Mode=TwoWay}" />
            </HorizontalStackLayout>

            <Label Text="Distance (km)" FontAttributes="Bold" />
            <Entry Text="{Binding DistanceKm, Mode=TwoWay}" Keyboard="Numeric" TextChanged="OnDistanceChanged" />

            <Label Text="Duration (hh:mm:ss)" FontAttributes="Bold" />
            <Entry Text="{Binding DurationText, Mode=TwoWay}" TextChanged="OnDurationChanged" />

            <Label Text="Steps" FontAttributes="Bold" />
            <Label Text="{Binding StepsText}" FontAttributes="Bold" />

            <Label Text="Calories" FontAttributes="Bold" />
            <Label Text="{Binding CaloriesText, StringFormat='{0} kcal'}" FontAttributes="Bold" />

            <HorizontalStackLayout Spacing="12">
                <Button Text="Save" Clicked="OnSaveClicked" />
                <Button Text="Cancel" Clicked="OnCancelClicked" />
            </HorizontalStackLayout>
        </VerticalStackLayout>
    </ScrollView>

</ContentPage>