<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="RunWise.Pages.ExerciseDetailPage"
             Title="Exercise">

    <StackLayout Padding="12" Spacing="10">
        <Label x:Name="TitleLabel" FontSize="20" FontAttributes="Bold" />
        <Label x:Name="DescLabel" FontSize="14" TextColor="Gray" />
        <Label x:Name="TipsLabel" FontSize="13" TextColor="DarkGray" />

        <Label Text="Instruction video" FontAttributes="Bold" Margin="0,8,0,0" />
        <WebView x:Name="VideoWebView" HeightRequest="240" IsVisible="False" />

        <Label x:Name="TimerLabel" Text="" FontSize="18" FontAttributes="Bold" HorizontalOptions="Center" />

        <HorizontalStackLayout Spacing="8">
            <Button Text="Previous" x:Name="PrevButton" Clicked="OnPrevClicked" />
            <Button Text="Next" x:Name="NextButton" Clicked="OnNextClicked" />
            <Button Text="Done" Clicked="OnDoneClicked" />
        </HorizontalStackLayout>
    </StackLayout>

</ContentPage>
