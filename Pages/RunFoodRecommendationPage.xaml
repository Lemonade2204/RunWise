<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="RunWise.Pages.RunFoodRecommendationPage"
             Title="Food Recommendation">

    <VerticalStackLayout Padding="20" Spacing="12">

        <Label x:Name="RunSummaryLabel" FontAttributes="Bold" />

        <Label Text="Search food (leave empty to use run calories):" />
        <Entry x:Name="SearchEntry" Placeholder="e.g. adobo" />
        <!-- Non-editable calories display -->
        <Label x:Name="CaloriesLabel" FontSize="16" />

        <!-- Refresh to re-run recommendation -->
        <Button Text="Refresh" Clicked="OnRefreshClicked" BackgroundColor="#6A1B9A" TextColor="White" />

        <Frame CornerRadius="6" Padding="10" BackgroundColor="#F2F2F2">
            <VerticalStackLayout>
                <Label x:Name="PickLabel" FontAttributes="Bold" />
            </VerticalStackLayout>
        </Frame>

        <Label Text="Suggestion:" FontAttributes="Bold" />

        <CollectionView x:Name="CandidatesList" VerticalOptions="FillAndExpand" HeightRequest="300">
            <CollectionView.ItemsLayout>
                <LinearItemsLayout Orientation="Vertical" ItemSpacing="8" />
            </CollectionView.ItemsLayout>
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Frame CornerRadius="8" Padding="10" Margin="0,4" BackgroundColor="#FFFFFF" BorderColor="#E0E0E0" HasShadow="False">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <VerticalStackLayout Grid.Column="0" Spacing="2">
                                <Label Text="{Binding Title}" FontAttributes="Bold" LineBreakMode="TailTruncation" />
                                <Label Text="{Binding Guidance}" FontAttributes="Italic" FontSize="Small" LineBreakMode="TailTruncation" />
                                <Label Text="{Binding Description}" FontSize="Small" TextColor="#666" LineBreakMode="TailTruncation" />
                            </VerticalStackLayout>

                            <VerticalStackLayout Grid.Column="1" HorizontalOptions="End" VerticalOptions="Center" Spacing="2">
                                <Label Text="{Binding CaloriesDisplay}" HorizontalTextAlignment="End" />
                                <Button Text="Add" Clicked="OnAddToMealClicked" FontSize="Small" />
                            </VerticalStackLayout>
                        </Grid>
                    </Frame>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </VerticalStackLayout>

</ContentPage>
