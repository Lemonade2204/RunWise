<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:RunWise.ViewModels"
             x:Class="RunWise.Pages.HistoryPage"
             ControlTemplate="{StaticResource BottomNavPageTemplate}"
             x:Name="ThisPage"
             BackgroundColor="#F7F8FC"
             Shell.BackgroundColor="#4B6BFB"
             Shell.TitleColor= "White"
            Shell.NavBarIsVisible="True"
             Title="Run History">

    <ContentPage.BindingContext>
        <vm:HistoryViewModel/>
    </ContentPage.BindingContext>

    <Grid RowDefinitions="Auto,*">
        <!-- Header with summary stats (larger cards, no filters) -->
        <Grid Grid.Row="0" BackgroundColor="#4B6BFB" Padding="16,28,16,22" RowSpacing="14"
              RowDefinitions="Auto,Auto">
            <Grid Grid.Row="1" ColumnDefinitions="*,*,*,*" ColumnSpacing="10">
                <Border Grid.Column="0" BackgroundColor="#6783FC" StrokeThickness="0" Padding="12,12"
                        StrokeShape="RoundRectangle 20">
                    <VerticalStackLayout HorizontalOptions="Center">
                        <Label Text="{Binding TotalRuns}" FontSize="18" FontAttributes="Bold" TextColor="White" HorizontalOptions="Center"/>
                        <Label Text="Runs" FontSize="12" TextColor="#DCE3FF" HorizontalOptions="Center"/>
                    </VerticalStackLayout>
                </Border>
                <Border Grid.Column="1" BackgroundColor="#6783FC" StrokeThickness="0" Padding="12,12"
                        StrokeShape="RoundRectangle 20">
                    <VerticalStackLayout HorizontalOptions="Center">
                        <Label Text="{Binding TotalDistanceKm, StringFormat='{0:F1}'}" FontSize="18" FontAttributes="Bold" TextColor="White" HorizontalOptions="Center"/>
                        <Label Text="km" FontSize="12" TextColor="#DCE3FF" HorizontalOptions="Center"/>
                    </VerticalStackLayout>
                </Border>
                <Border Grid.Column="2" BackgroundColor="#6783FC" StrokeThickness="0" Padding="12,12"
                        StrokeShape="RoundRectangle 20">
                    <VerticalStackLayout HorizontalOptions="Center">
                        <Label Text="{Binding TotalCalories, StringFormat='{0:N0}'}" FontSize="18" FontAttributes="Bold" TextColor="White" HorizontalOptions="Center"/>
                        <Label Text="kcal" FontSize="12" TextColor="#DCE3FF" HorizontalOptions="Center"/>
                    </VerticalStackLayout>
                </Border>
                <Border Grid.Column="3" BackgroundColor="#6783FC" StrokeThickness="0" Padding="12,12"
                        StrokeShape="RoundRectangle 20">
                    <VerticalStackLayout HorizontalOptions="Center">
                        <Label Text="{Binding OverallAveragePaceFormatted}" FontSize="18" FontAttributes="Bold" TextColor="White" HorizontalOptions="Center"/>
                        <Label Text="avg pace" FontSize="12" TextColor="#DCE3FF" HorizontalOptions="Center"/>
                    </VerticalStackLayout>
                </Border>
            </Grid>
        </Grid>

        <!-- Loading -->
        <ActivityIndicator Grid.Row="1"
                           IsRunning="{Binding IsLoading}"
                           IsVisible="{Binding IsLoading}"
                           Color="#4B6BFB"
                           VerticalOptions="Center"
                           HorizontalOptions="Center"/>

        <CollectionView Grid.Row="1"
                        ItemsSource="{Binding RunHistory}"
                        SelectionMode="None"
                        Margin="0,12,0,0">

            <!-- No banner: removed Personal Best per request -->

            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Border Margin="12,10" Padding="0"
                            BackgroundColor="White"
                            Stroke="#EEF0F6"
                            StrokeShape="RoundRectangle 22">
                        <Border.Shadow>
                            <Shadow Brush="Black" Opacity="0.09" Radius="10" Offset="0,3"/>
                        </Border.Shadow>

                        <VerticalStackLayout>

                            <VerticalStackLayout Padding="18,18,18,14" Spacing="12">

                                <!-- Distance + date -->
                                <VerticalStackLayout Spacing="2">
                                    <HorizontalStackLayout Spacing="6" VerticalOptions="Center">
                                        <Label Text="{Binding DistanceFormatted}" FontSize="22" FontAttributes="Bold" TextColor="#1F2340"/>
                                        <Label Text="km" FontSize="12" TextColor="#8A8FA8" VerticalOptions="Center"/>
                                    </HorizontalStackLayout>
                                    <Label Text="{Binding StartTime, StringFormat='{0:MMM dd, yyyy}'}" FontSize="14" TextColor="#8A8FA8"/>
                                </VerticalStackLayout>

                                <!-- Progress -->
                                <ProgressBar Progress="{Binding DistanceProgress}" ProgressColor="#6A4BFB" HeightRequest="6"/>

                                <!-- Stats -->
                                <Grid ColumnDefinitions="*,*,*">
                                    <VerticalStackLayout Grid.Column="0">
                                        <Label Text="{Binding DurationFormatted}" FontSize="14" FontAttributes="Bold" TextColor="#1F2340"/>
                                        <Label Text="Time" FontSize="12" TextColor="#8A8FA8"/>
                                    </VerticalStackLayout>
                                    <VerticalStackLayout Grid.Column="1">
                                        <Label Text="{Binding AveragePaceFormatted}" FontSize="14" FontAttributes="Bold" TextColor="#1F2340"/>
                                        <Label Text="Pace" FontSize="12" TextColor="#8A8FA8"/>
                                    </VerticalStackLayout>
                                    <VerticalStackLayout Grid.Column="2">
                                        <Label Text="{Binding Calories, StringFormat='{0} kcal'}" FontSize="14" FontAttributes="Bold" TextColor="#1F2340"/>
                                        <Label Text="Calories" FontSize="12" TextColor="#8A8FA8"/>
                                    </VerticalStackLayout>
                                </Grid>
                            </VerticalStackLayout>

                            <BoxView HeightRequest="1" Color="#EEF0F6"/>

                            <!-- Actions -->
                            <Grid ColumnDefinitions="*,Auto,*">
                                <Button Grid.Column="0"
                                        Text="View Details"
                                        FontSize="13"
                                        BackgroundColor="Transparent"
                                        TextColor="#4B6BFB"
                                        Clicked="OnViewClicked"
                                        CommandParameter="{Binding .}"/>
                                <BoxView Grid.Column="1" WidthRequest="1" Color="#EEF0F6"/>
                                <Button Grid.Column="2"
                                        Text="Share"
                                        FontSize="13"
                                        BackgroundColor="Transparent"
                                        TextColor="#6B7090"
                                        Clicked="OnShareClicked"
                                        CommandParameter="{Binding .}"/>
                            </Grid>
                        </VerticalStackLayout>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>

            <CollectionView.EmptyView>
                <StackLayout Padding="20" VerticalOptions="Center" HorizontalOptions="Center">
                    <Label Text="No runs yet!"
                           FontSize="18" FontAttributes="Bold"
                           HorizontalTextAlignment="Center"/>
                    <Label Text="Start tracking your first run to see it here"
                           FontSize="14" TextColor="#666"
                           HorizontalTextAlignment="Center"/>
                </StackLayout>
            </CollectionView.EmptyView>

        </CollectionView>
    </Grid>
</ContentPage>
